# URL HTTPS definitiva cadastrada no Cloudflare Tunnel. Nao termina com /mcp
PUBLIC_BASE_URL=https://mcp.SEUDOMINIO.com.br
# Senha de inscricao da bancada com pelo menos 16 caracteres (nao publicar)
REGISTRATION_CODE=TROQUE-ESTE-CODIGO-POR-UM-SEGREDO-LONGO
# cloudflared Tunnel token do dashboard (NUNCA publicar)
TUNNEL_TOKEN=COLE-O-TOKEN-APENAS-NA-SUA-MAQUINA
# Localizacao persistente do banco JSON dentro do container
DATA_FILE=/data/runtime.json
PORT=3100
HOST=0.0.0.0

# EXPERIMENTAL: acesso MCP sem OAuth + vinculacao de cada conversa no site.
# Sem esta flag, o OAuth anterior e obrigatorio.
CHAT_LOGIN_ENABLED=false

# Origem exata da aplicacao estatica C4 autorizada a fazer login/sincronizar.
C4_GAME_ORIGIN=https://jogo.portrasdaoferta.workers.dev
# Cadastro de demonstracao com SOMENTE apelido e senha (ate 50 contas).
C4_SIGNUP_ENABLED=true
